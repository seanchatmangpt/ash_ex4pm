<%
# ggen_igniter EEx template -> test/support/micro_beam4pm.ex
#
# Bindings: admitted - list of string-keyed maps: "operation",
#           "jsonApiType", "actionName", "httpMethod", one row per LIVE
#           (non-forward_declared) ex4pmb:AdmittedBeam4pmService
#           individual (see priv/ggen/queries/admitted_beam4pm_services_live.rq).
#
# This is the SINGLE source for the MicroBeam4pm test fixture -- a real
# Ash resource + real AshJsonApi.Router + real Bandit HTTP server standing
# in for beam4pm's own (not-yet-mounted) json_api surface, previously
# hand-duplicated identically in both ex4pm's and ash_ex4pm's test/support
# directories (a real, confirmed drift risk). Both repos now render this
# same template from the same admitted graph, so the fixture can never
# silently diverge from beam4pm's own live route table again.
#
# Resource-attribute shape is NOT modeled in the ontology (only
# operation/jsonApiType/actionName/httpMethod are), so the small
# per-jsonApiType attribute map below is the disclosed, template-level
# extension point: a newly admitted LIVE service whose jsonApiType isn't
# in this map renders as an honest TODO stub instead of silently wrong
# generated code -- add a case here when that happens.

known_resources = %{
  "ocel_event" => %{
    module: "OcelEvent",
    attributes: [{"activity", ":string, allow_nil?: false, public?: true"}, {"timestamp", ":string, public?: true"}],
    create_accept: "[:activity, :timestamp]",
    # Fixture-specific, not derived from the admitted operation's
    # actionName: tests need to seed ocel_event data via a real POST even
    # though the admitted beam4pm_ocel_events operation itself is a read.
    fixture_exposes_create_route?: true
  },
  "conformance_result" => %{
    module: "ConformanceResult",
    attributes: [{"fitness", ":float, default: 1.0, public?: true"}],
    create_accept: "[:fitness]",
    fixture_exposes_create_route?: false
  }
}

live_rows =
  admitted
  |> Enum.uniq_by(& &1["jsonApiType"])
  |> Enum.sort_by(& &1["jsonApiType"])

{known_rows, unknown_rows} = Enum.split_with(live_rows, &Map.has_key?(known_resources, &1["jsonApiType"]))

resource_defs =
  Enum.map_join(known_rows, "\n\n", fn row ->
    r = known_resources[row["jsonApiType"]]

    attrs_block =
      Enum.map_join(r.attributes, "\n    ", fn {name, spec} -> "attribute(:#{name}, #{spec})" end)

    routes_block =
      if r.fixture_exposes_create_route? do
        "base(\"/#{row["jsonApiType"]}\")\n      index(:read)\n      get(:read)\n      post(:create)"
      else
        "base(\"/#{row["jsonApiType"]}\")\n      index(:read)\n      get(:read)"
      end

    """
    defmodule MicroBeam4pm.#{r.module} do
      @moduledoc \"\"\"
      Real Ash resource + AshJsonApi exposure standing in for beam4pm's
      real, already-existing `BeamPM.Ash.Resources.#{r.module}` -- GENERATED
      from the live (non-forward_declared) `ex4pmb:AdmittedBeam4pmService`
      individual for operation `#{row["operation"]}`, so this fixture can
      never silently drift from beam4pm's own admitted route table.
      \"\"\"
      use Ash.Resource,
        domain: MicroBeam4pm.Domain,
        data_layer: Ash.DataLayer.Ets,
        extensions: [AshJsonApi.Resource]

      json_api do
        type "#{row["jsonApiType"]}"

        routes do
          #{routes_block}
        end
      end

      actions do
        defaults([:read, :destroy])

        create :create do
          primary?(true)
          accept(#{r.create_accept})
        end
      end

      attributes do
        uuid_primary_key(:id)
        #{attrs_block}
      end
    end
    """
  end)

unknown_stub =
  Enum.map_join(unknown_rows, "\n", fn row ->
    "# TODO(ggen): live operation `#{row["operation"]}` (jsonApiType " <>
      "#{inspect(row["jsonApiType"])}) has no known attribute shape in " <>
      "priv/ggen/templates/micro_beam4pm.ex.eex's `known_resources` map -- " <>
      "add one, then regenerate, before this fixture can stand in for it."
  end)

resource_modules = Enum.map(known_rows, fn row -> "MicroBeam4pm.#{known_resources[row["jsonApiType"]].module}" end)

resource_list = Enum.map_join(resource_modules, "\n    ", fn m -> "resource(#{m})" end)
%># GENERATED by ggen_igniter from ex4pm's admitted ex4pmb:AdmittedBeam4pmService
# graph (the live subset). Do not edit.
<%= if unknown_stub != "" do %>
<%= unknown_stub %>
<% end %>
<%= resource_defs %>

defmodule MicroBeam4pm.Domain do
  @moduledoc """
  Real Ash.Domain with AshJsonApi.Domain -- the same extension pairing
  beam4pm's own real `BeamPM.Ash.Domain` would need for its planned
  json_api exposure. GENERATED: resource list mirrors every LIVE admitted
  ex4pmb:AdmittedBeam4pmService individual.
  """
  use Ash.Domain, extensions: [AshJsonApi.Domain], validate_config_inclusion?: false

  resources do
    <%= resource_list %>
  end
end

defmodule MicroBeam4pm.Router do
  @moduledoc """
  Real AshJsonApi.Router standing in for beam4pm's not-yet-mounted
  json_api surface.
  """
  use AshJsonApi.Router,
    domains: [MicroBeam4pm.Domain],
    open_api: "/openapi.json"
end
