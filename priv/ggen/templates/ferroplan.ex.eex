<%
# ggen_igniter EEx template -> lib/ash_ex4pm/ferroplan.ex
#
# Bindings (from `mix ggen_igniter.sync
#   --query admitted=priv/ggen/queries/admitted_ferroplan_activities.rq`,
#   run against ex4pm's OWN packaged priv/ontology/ex4pm.ttl -- see
#   lib/mix/tasks/ash_ex4pm.ggen.sync.ex, which resolves that path via
#   Application.app_dir(:ex4pm, ...) rather than this repo forking a
#   second copy of the ontology):
#   admitted - list of string-keyed maps: "operation", "jsonApiType",
#              "actionName", "httpMethod", "planningType", "status"
#
# This module is a thin delegate, not a second contract: every generated
# function forwards straight to Ex4pm.Engine.Beam4pm.execute/3, which is
# itself a facade over beam4pm (see that module's own moduledoc). ash_ex4pm
# never talks to beam4pm or ferroplan-wasm directly -- ex4pm remains the
# single admitted client, exactly as the user directed.

admitted_rows =
  admitted
  |> Enum.map(fn a ->
    %{
      operation: a["operation"],
      planning_type: a["planningType"],
      status: a["status"] || "live"
    }
  end)
  |> Enum.sort_by(& &1.operation)

function_docs =
  Enum.map_join(admitted_rows, "\n", fn r ->
    status_note = if r.status == "live", do: "", else: " (#{r.status})"
    "    * `#{r.operation}/2` -> `Ex4pm.Engine.Beam4pm.execute(:#{r.operation}, subject, opts)` (planning type `#{r.planning_type}`)#{status_note}"
  end)

functions =
  Enum.map_join(admitted_rows, "\n\n", fn r ->
    """
      @doc \"\"\"
      Delegates to `Ex4pm.Engine.Beam4pm.execute(:#{r.operation}, subject, opts)` --
      ferroplan's #{r.planning_type} planning capability, admitted as an
      ex4pmb:AdmittedBeam4pmService individual. Status: `#{r.status}`.
      \"\"\"
      @spec #{r.operation}(map(), keyword()) :: {:ok, Ex4pm.Engine.Result.t()} | {:error, Ex4pm.Refusal.t()}
      def #{r.operation}(subject, opts \\\\ []) do
        Ex4pm.Engine.Beam4pm.execute(:#{r.operation}, subject, opts)
      end
    """
  end)
%># GENERATED by ggen_igniter from ex4pm's admitted ex4pmb:AdmittedBeam4pmService
# graph (the planning-typed subset). Do not edit.
defmodule AshEx4pm.Ferroplan do
  @moduledoc """
  Thin delegate exposing ex4pm's admitted ferroplan planning capabilities to
  Ash resource authors, generated from the SAME
  `ex4pmb:AdmittedBeam4pmService` graph `Ex4pm.Engine.Beam4pm` itself is
  generated from (ex4pm's `priv/ontology/ex4pm.ttl`, queried from this
  repo's packaged `ex4pm` dependency -- see
  `lib/mix/tasks/ash_ex4pm.ggen.sync.ex`). No ontology fork, no independent
  contract: adding a new planning capability here means adding a new
  `ex4pmb:AdmittedBeam4pmService` individual (with a bound
  `ex4pmb:planningType`) in ex4pm's ontology, cutting a new ex4pm release,
  bumping this repo's `{:ex4pm, ...}` pin, and re-running
  `mix ash_ex4pm.ggen.sync` -- never hand-written dispatch code here.

  Generated functions:

  <%= function_docs %>

  ## Honest status

  Every function here ultimately depends on `Ex4pm.Engine.Beam4pm`'s own
  admitted route table. A `(forward_declared)` capability above refuses
  with `:beam4pm_route_not_live` until beam4pm mounts the matching
  `json_api` route -- see `Ex4pm.Engine.Beam4pm`'s own moduledoc for the
  full disclosure.
  """

<%= functions %>
end
